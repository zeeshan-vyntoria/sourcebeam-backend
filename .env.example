# Copy this file to .env, then replace the values with your PostgreSQL details.
DATABASE_URL=postgresql+psycopg_async://postgres:your_password@localhost:5432/ai_backend
APP_HOST=127.0.0.1
APP_PORT=8000

# Create a key in Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_random_value_of_at_least_43_characters
JWT_ACCESS_TOKEN_MINUTES=60
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_RATE_LIMIT_REQUESTS=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_MAX_CONCURRENCY=4
AI_REQUEST_TIMEOUT_SECONDS=45
RAG_MAX_PDF_BYTES=15728640
RAG_MAX_PDF_PAGES=250
RAG_MAX_EXTRACTED_CHARACTERS=1000000
RAG_CHUNK_CHARACTERS=2400
RAG_CHUNK_OVERLAP_CHARACTERS=320
RAG_RETRIEVAL_TOP_K=6
RAG_CANDIDATE_POOL=24
RAG_MIN_SIMILARITY=0.20
RAG_HYBRID_ENABLED=true
RAG_RERANK_ENABLED=true
RAG_RERANK_CANDIDATES=12
OCR_ENABLED=true
OCR_MIN_PAGE_CHARACTERS=40
OCR_RENDER_DPI=200
INGESTION_POLL_SECONDS=1
INGESTION_MAX_ATTEMPTS=3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.sourcebeam-storage
# For S3-compatible production storage:
S3_ENDPOINT_URL=
S3_BUCKET=sourcebeam
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
PUBLIC_DAILY_AI_MESSAGES=50
PUBLIC_DAILY_UPLOADS=20
PUBLIC_USER_STORAGE_BYTES=262144000
IMAGE_MAX_BYTES=8388608
IMAGE_MAX_PIXELS=20000000
IMAGE_MAX_DIMENSION=8192
IMAGE_MAX_PER_MESSAGE=3
IMAGE_CONTEXT_MAX_BYTES=16777216
CONVERSATION_CONTEXT_CHARACTERS=40000
